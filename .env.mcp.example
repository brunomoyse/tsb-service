# tsb-mcp configuration. Copy to .env.mcp for `make mcp-run`.

# tsb-service API root (the MCP calls ${UPSTREAM_BASE_URL}/graphql).
UPSTREAM_BASE_URL=http://localhost:8080/api/v1

# Zitadel machine user `tsb-mcp` (access token type JWT, admin role grant,
# client secret). Its client id must be listed in tsb-service's
# ZITADEL_ADMIN_CLIENT_IDS.
ZITADEL_ISSUER=https://auth.tokyosushibarliege.be
ZITADEL_CLIENT_ID=tsb-mcp
ZITADEL_CLIENT_SECRET=change-me
ZITADEL_PROJECT_ID=000000000000000000
# Optional in-cluster Zitadel URL; the public issuer host is sent as Host header.
ZITADEL_INTERNAL_URL=

# Bearer token required on the MCP Streamable HTTP endpoint (--http).
MCP_AUTH_TOKEN=change-me-mcp
# Bearer token of the internal apply/reject API (--internal). Only the agent
# service knows it. Must differ from MCP_AUTH_TOKEN.
INTERNAL_API_TOKEN=change-me-internal

# SQLite database for pending changes and the audit log.
DB_PATH=./tsb-mcp.db
# How long a proposed change waits for the owner's yes/no.
PENDING_TTL=10m
# Largest allowed price change, in percent of the current price.
PRICE_MAX_CHANGE_PCT=50
# Timezone for times given without an offset.
TZ_DEFAULT=Europe/Brussels
# debug, info, warn or error. Logs are JSON on stderr.
LOG_LEVEL=info
