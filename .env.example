DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL_MODE=disable

# Optional: separate admin DB credentials (falls back to DB_USERNAME/DB_PASSWORD if not set)
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=

# Zitadel OIDC (replaces JWT_SECRET)
ZITADEL_ISSUER=https://auth.tokyosushibarliege.be
ZITADEL_INTERNAL_URL=
ZITADEL_CLIENT_ID=
# OIDC client of the iOS/Android app: allowed by /auth/token-exchange, and its
# tokens mark a request as coming from the app (required by app-only coupons).
ZITADEL_NATIVE_CLIENT_ID=
# Comma-separated OIDC client IDs (the dashboard) whose tokens may carry the
# admin role. Empty = any client (legacy). Dashboard logins also enforce TOTP
# for staff who enrolled it.
ZITADEL_ADMIN_CLIENT_IDS=
ZITADEL_SERVICE_PAT=
ZITADEL_ADMIN_PAT=

APP_ENV=development
# Set to true to accept orders regardless of opening hours and the ordering
# switch (local development only, never in production).
ORDERING_GATE_DISABLED=
LOG_LEVEL=info
LOG_FORMAT=text
# HTTP listen port (default 8080). Override to run a second brand instance
# side by side, e.g. PORT=8081 for the ygfliege dev backend.
PORT=

MOLLIE_API_TOKEN=
MOLLIE_TESTING=true
MOLLIE_WEBHOOK_URL=

ENABLE_GQL_INTROSPECTION=true

APP_BASE_URL=
API_BASE_URL=
APP_DASHBOARD_URL=
# Optional, comma-separated: extra browser origins allowed by CORS and the GraphQL websocket
# (e.g. a former dashboard host during a move).
APP_EXTRA_ORIGINS=

# Restaurant branding (white-label). All optional, defaults are the Tokyo
# Sushi Bar values shown below, so existing deployments need no changes.
# RESTAURANT_NAME=Tokyo Sushi Bar
# RESTAURANT_LEGAL_NAME=Tokyo Sushi Bar SRL
# RESTAURANT_ADDRESS=Rue de la Cathédrale 59, 4000 Liège, Belgique
# RESTAURANT_PHONE=+32 4 222 98 88
# RESTAURANT_EMAIL=tokyosushibar888@gmail.com
# RESTAURANT_VAT=BE0772.499.585
# RESTAURANT_DOMAIN=tokyosushibarliege.be
# RESTAURANT_LOGO_PATH=/images/tsb-black-font-100.png
# RESTAURANT_INVOICE_PREFIX=TSB
# Set to false for a takeaway-only instance: delivery orders are refused (DELIVERY_UNAVAILABLE)
# and RestaurantConfig.policy.deliveryEnabled tells the clients. Default: true.
# RESTAURANT_DELIVERY_ENABLED=true
# Optional path to a PNG logo for invoice PDFs; embedded TSB logo if unset.
# INVOICE_LOGO_PATH=

# Google Maps API (for address autocomplete, place details, and distance matrix)
GOOGLE_MAPS_API_KEY=
RESTAURANT_ORIGIN_LAT=50.64245770697728
RESTAURANT_ORIGIN_LNG=5.574703166758179
GOOGLE_MAPS_LANGUAGE=fr
# Restrict autocomplete suggestions to a circle around the restaurant.
# 0 disables; 15 000 m covers greater Liège and skips useless suggestions.
AUTOCOMPLETE_RADIUS_METERS=15000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_REGION=
AWS_BUCKET=
AWS_URL=

# File service (S3 image upload/rename/delete)
FILE_SERVICE_URL=

# Zitadel social IdP IDs (from Zitadel console → Identity Providers)
ZITADEL_IDP_GOOGLE_ID=
ZITADEL_IDP_APPLE_ID=

SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_SENDER_EMAIL=
SCW_SENDER_NAME=
SCW_REGION="fr-par"

# SMTP override (dev/e2e). When SMTP_HOST is set, all transactional email
# bypasses Scaleway TEM and is delivered via plain SMTP, typically Mailpit
# at localhost:1025 (web UI on :8025). Leave empty in production.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# E2E OTP email allowlist. Comma-separated loginNames that bypass the real
# OTP email send during /auth/session/otp/{request,resend}. Zitadel still
# stores the encrypted code in eventstore.events2, so e2e can recover it via
# the DB. Leave empty in production.
E2E_NO_SEND_LOGINS=

# Store-review OTP access (Google Play / App Store). App reviewers can't receive
# the OTP email, so for these accounts the email is suppressed and the latest
# code is exposed at GET /auth/review/last-otp?login=<email>&key=<REVIEW_OTP_KEY>.
# Both must be set to enable it; leave empty to disable entirely (route 404s).
REVIEW_OTP_LOGINS=
REVIEW_OTP_KEY=
# Zitadel user ids (comma-separated) of the store-review accounts. Only these
# may order outside opening hours; their orders are hidden test orders.
REVIEW_ZITADEL_SUBS=

# APNs (iOS push notifications: optional, app works without)
APNS_AUTH_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=be.tokyosushibarliege.mobile

# FCM (Android push notifications: optional, app works without)
# Set to the path of the Firebase service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare Turnstile (bot protection: optional, skipped if empty)
TURNSTILE_SECRET_KEY=

# POS (tsb-pos-android) auth: HS256 signing key for RRN-issued app JWTs.
# Must be at least 32 random bytes; rotate to invalidate all POS sessions.
# If unset, the server generates an ephemeral key at boot (all tokens invalid
# across restarts, fine for dev, not for prod).
POS_JWT_SECRET=

# Telegram assistant (tsb-agent admin API). Unset = assistant disabled in the
# dashboard. ASSISTANT_ALERT_EMAIL receives the "Telegram bot refused" email.
# ASSISTANT_AGENT_URL=http://tsb-agent:8082
# ASSISTANT_ADMIN_TOKEN=
# ASSISTANT_ALERT_EMAIL=
# It also receives the HubRise "order not accepted" email (when HubRise is on).

# HubRise (EPOS integration: optional). The integration exists on a deployment only when
# HUBRISE_CLIENT_ID, HUBRISE_CLIENT_SECRET and HUBRISE_TOKEN_KEY are all set; otherwise the shop is
# the standalone shop (no route, hook or worker). Once available, the restaurant connects from the
# dashboard and turns each feature on there. See docs/hubrise/README.md for the runbook.
# OAuth client registered at HubRise (developer portal). Its redirect URI must be
# <API_BASE_URL>/hubrise/oauth/callback (API_BASE_URL above includes /api/v1).
# HUBRISE_CLIENT_ID=
# HUBRISE_CLIENT_SECRET=
# Seals the HubRise access token in the database: base64 of 32 random bytes
# (openssl rand -base64 32). Losing or changing it makes the stored token unreadable: reconnect from
# the dashboard.
# HUBRISE_TOKEN_KEY=
# Number of API replicas (default 2, as in production): the HubRise rate budget of the connection is
# shared by all of them.
# HUBRISE_REPLICAS=2
# Overrides for local development against another server (the in-memory mock in pkg/hubrise/hubrisetest
# is what the tests use).
# HUBRISE_API_BASE_URL=https://api.hubrise.com/v1
# HUBRISE_OAUTH_BASE_URL=https://manager.hubrise.com/oauth2/v1
# Public base URL of the product images, read when the dashboard-owned menu publishes images to HubRise
# (publishImages): <base>/images/thumbnails/<product id>.png. Defaults to S3_BUCKET_URL, then AWS_URL.
# HUBRISE_IMAGE_BASE_URL=
